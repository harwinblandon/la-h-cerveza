rules_version = '2';

// La H Cerveza Artesanal.
// Plantilla: al publicar (scripts/publicar-reglas.mjs) CORREO_DEL_ADMINISTRADOR se reemplaza por el
// correo del archivo local .admin-email, que no se sube al repositorio.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'CORREO_DEL_ADMINISTRADOR'
        && request.auth.token.email_verified == true;
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function suspended(uid) {
      return exists(/databases/$(database)/documents/members/$(uid))
        && get(/databases/$(database)/documents/members/$(uid)).data.get('blocked', false) == true;
    }

    // Datos del cervecero: solo su cuenta los lee; una cuenta suspendida no puede escribir.
    match /users/{uid}/{document=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && !suspended(uid);
    }

    // Resumen de uso por cuenta: lo escribe su dueño (sin tocar la suspensión); el administrador lo lee todo
    // y puede suspender o reactivar.
    match /members/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && !('blocked' in request.resource.data);
      allow update: if (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['blocked']))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blocked', 'blockedAt']));
      allow delete: if isOwner(uid);
    }

    // Uso anónimo de la app: un contador por día y una marca por equipo (sin datos personales).
    match /usage/{day} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['opens', 'cuenta', 'local', 'sinRegistro'])
        && request.resource.data.opens == 1;
      allow update: if request.resource.data.keys().hasOnly(['opens', 'cuenta', 'local', 'sinRegistro'])
        && request.resource.data.opens == resource.data.get('opens', 0) + 1
        && request.resource.data.get('cuenta', 0) - resource.data.get('cuenta', 0) <= 1
        && request.resource.data.get('local', 0) - resource.data.get('local', 0) <= 1
        && request.resource.data.get('sinRegistro', 0) - resource.data.get('sinRegistro', 0) <= 1;
      match /devices/{device} {
        allow read: if isAdmin();
        allow create: if request.resource.data.keys().hasOnly(['kind']) && request.resource.data.kind in ['cuenta', 'local', 'sinRegistro'];
      }
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
